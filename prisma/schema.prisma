  shipmentPackages      ShipmentPackage[]
  events                PackageEvent[]
  rmaItems              RmaItem[]
  exceptions            PackageException[]
  serviceLinks          PackageServicePackage[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([orderId, status])
  privateMediaHolds PrivateMediaHold[]

}

model PackageException {
  id             String                 @id @default(uuid())
  reference      String                 @unique
  idempotencyKey String                 @unique
  type           PackageExceptionType
  status         PackageExceptionStatus @default(OPEN)
  orderId        String
  packageId      String?
  warehouseId    String
  reportedById   String
  resolvedById   String?
  description    String
  resolutionNote String?
  customerNote   String?
  resolvedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  order          Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  package        Package?               @relation(fields: [packageId], references: [id], onDelete: Restrict)
  warehouse      Warehouse              @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  reportedBy     User                   @relation("PackageExceptionReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  resolvedBy     User?                  @relation("PackageExceptionResolver", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([orderId, status])
  @@index([warehouseId, status])
  @@index([packageId, status])
}

model PackageServiceRequest {
  id                      String                  @id @default(uuid())
  reference               String                  @unique
  idempotencyKey          String                  @unique
  executionIdempotencyKey String?                 @unique
  orderId                 String
  customerId              String
  type                    PackageServiceType
  status                  PackageServiceStatus    @default(REQUESTED)
  requestedOutputCount    Int                     @default(1)
  customerNote            String?
  adminNote               String?
  reviewCustomerNote      String?
  warehouseNote           String?
  reviewedById            String?
  completedById           String?
  reviewedAt              DateTime?
  completedAt             DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  order                   Order                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer                User                    @relation("PackageServiceCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  reviewedBy              User?                   @relation("PackageServiceReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  completedBy             User?                   @relation("PackageServiceWorker", fields: [completedById], references: [id], onDelete: Restrict)
  packages                PackageServicePackage[]

  @@index([customerId, status, createdAt])
  @@index([orderId, status])
  @@index([status, createdAt])
}

model PackageServicePackage {
  requestId String
  packageId String
  role      PackageServicePackageRole
  request   PackageServiceRequest     @relation(fields: [requestId], references: [id], onDelete: Restrict)
  package   Package                   @relation(fields: [packageId], references: [id], onDelete: Restrict)

  @@id([requestId, packageId])
  @@index([packageId, role])
}

model PackageEvent {
  id           String           @id @default(uuid())
  packageId    String
  eventType    PackageEventType
  status       PackageStatus
  actorId      String?
  locationCode String?
  note         String?
  metadata     Json?
  occurredAt   DateTime         @default(now())
  package      Package          @relation(fields: [packageId], references: [id], onDelete: Restrict)
  actor        User?            @relation("PackageEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([packageId, occurredAt])
  @@index([eventType, occurredAt])
}

model Inspection {
  id          String   @id @default(uuid())
  idempotencyKey String? @unique
  requestFingerprint String?
  packageId   String
  inspectorId String
  type        String
  result      String
  notes       String?
  mediaRefs   Json?
  package     Package  @relation(fields: [packageId], references: [id], onDelete: Restrict)
  inspector   User     @relation("InspectionInspector", fields: [inspectorId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@index([inspectorId, createdAt])
}

// Private warehouse/inspection evidence. The ciphertext is never exposed by a
// public asset route; authorised staff and the owning customer receive it only
// through the access-controlled evidence endpoint.
model InspectionEvidence {
  id             String   @id @default(uuid())
  packageId      String
  uploadedById   String
  mediaKind      String
  mimeType       String   @db.VarChar(64)
  sizeBytes      Int
  sha256         String   @db.VarChar(64)
  ciphertext     String?
  iv             String?  @db.VarChar(32)
  authTag        String?  @db.VarChar(32)
  originalName   String?  @db.VarChar(180)
  createdAt      DateTime @default(now())
  package        Package  @relation(fields: [packageId], references: [id], onDelete: Restrict)
  uploadedBy     User     @relation("InspectionEvidenceUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  privatePhotoLink PrivatePhotoLink?

  @@index([packageId, createdAt])
  @@index([uploadedById, createdAt])
}

model Shipment {
  id                     String            @id @default(uuid())
  shipmentCode           String            @unique @default(dbgenerated())
  trackingNumber         String            @unique
  status                 ShipmentStatus    @default(CREATED)
  originWarehouseId      String?
  destinationWarehouseId String?
