  destinationWarehouse   Warehouse?        @relation("ShipmentDestinationWarehouse", fields: [destinationWarehouseId], references: [id], onDelete: Restrict)
  packages               ShipmentPackage[]
  events                 ShipmentEvent[]
  rmas                   Rma[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([originWarehouseId, status])
  @@index([destinationWarehouseId, status])
}

model ShipmentPackage {
  shipmentId String
  packageId  String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  package    Package  @relation(fields: [packageId], references: [id], onDelete: Restrict)

  @@id([shipmentId, packageId])
  @@unique([packageId])
}

model ShipmentEvent {
  id             String         @id @default(uuid())
  shipmentId     String
  status         ShipmentStatus
  location       String?
  description    String?
  actorId        String?
  mediaRefs      Json?
  metadata       Json?
  idempotencyKey String?        @unique
  occurredAt     DateTime       @default(now())
  shipment       Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  actor          User?          @relation("ShipmentEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([shipmentId, occurredAt])
}

model OrderStatusHistory {
  supplierRecordCorrection SupplierRecordCorrection?
  id         String       @id @default(uuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorId    String?
  note       String?
  createdAt  DateTime     @default(now())
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
}

model SourcingRequest {
  id                 String                @id @default(uuid())
  reference          String                @unique
  customerId         String
  sourceCountryCode  String                @default("CN")
  sourcePlatformCode SourcePlatformType?
  productUrl         String
  productTitle       String?
  selectedVariant    String?
  quantity           Int                   @default(1)
  sourcePrice        Decimal?              @db.Decimal(12, 2)
  sourceCurrency     String?
  customerNote       String?
  status             SourcingRequestStatus @default(SUBMITTED)
  customer           User                  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotes             SourcingQuote[]
  order              Order?
  accountActivities  AccountActivity[]
  opportunity        SalesOpportunity?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([customerId, status])
}

enum BusinessAccountStatus {
  ACTIVE
  ON_HOLD
  CLOSED
}

enum KamAssignmentRole {
  PRIMARY
  SUPPORT
}

enum AccountActivityType {
  CALL
  MEETING
  EMAIL
  NOTE
  FOLLOW_UP
}

enum SalesOpportunityStage {
  DISCOVERY
  QUALIFIED
  QUOTED
  NEGOTIATION
  WON
  LOST
}

model BusinessAccount {
  id               String                @id @default(uuid())
  accountCode      String                @unique @default(dbgenerated())
  ownerId          String                @unique
  organizationName String
  status           BusinessAccountStatus @default(ACTIVE)
  version          Int                   @default(1)
  owner            User                  @relation("BusinessAccountOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  assignments      KamAssignment[]
  activities       AccountActivity[]
  opportunities    SalesOpportunity[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([status, createdAt])
}

model KamAssignment {
  id            String            @id @default(uuid())
  accountId     String
  userId        String
  role          KamAssignmentRole @default(PRIMARY)
  isActive      Boolean           @default(true)
  assignedById  String
  assignedAt    DateTime          @default(now())
  deactivatedAt DateTime?
  account       BusinessAccount   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  user          User              @relation("KamAssignee", fields: [userId], references: [id], onDelete: Restrict)
  assignedBy    User              @relation("KamAssigner", fields: [assignedById], references: [id], onDelete: Restrict)

  @@unique([accountId, userId])
  @@index([userId, isActive])
  @@index([accountId, isActive])
}

model AccountActivity {
  id                String              @id @default(uuid())
  activityCode      String              @unique @default(dbgenerated())
  accountId         String
  authorId          String
  type              AccountActivityType
  subject           String
  note              String
  occurredAt        DateTime
  followUpAt        DateTime?
  sourcingRequestId String?
  idempotencyKey    String              @unique
  account           BusinessAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  author            User                @relation("AccountActivityAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  sourcingRequest   SourcingRequest?    @relation(fields: [sourcingRequestId], references: [id], onDelete: Restrict)
  createdAt         DateTime            @default(now())

  @@index([accountId, occurredAt])
  @@index([authorId, createdAt])
  @@index([followUpAt])
}

model SalesOpportunity {
  id                 String                   @id @default(uuid())
  opportunityCode    String                   @unique @default(dbgenerated())
  accountId          String
  ownerId            String
  sourcingRequestId  String?                  @unique
  title              String
  stage              SalesOpportunityStage    @default(DISCOVERY)
  idempotencyKey     String                   @unique
  requestFingerprint String
  estimatedValue     Decimal?                 @db.Decimal(14, 2)
  currency           String?
  expectedCloseAt    DateTime?
  note               String?
  version            Int                      @default(1)
  account            BusinessAccount          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  owner              User                     @relation("SalesOpportunityOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  sourcingRequest    SourcingRequest?         @relation(fields: [sourcingRequestId], references: [id], onDelete: Restrict)
  stageChanges       OpportunityStageChange[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([accountId, stage, updatedAt])
  @@index([ownerId, stage, updatedAt])
  @@index([expectedCloseAt])
}

model OpportunityStageChange {
  id                 String                 @id @default(uuid())
  opportunityId      String
  fromStage          SalesOpportunityStage?
  toStage            SalesOpportunityStage
  actorId            String
  note               String?
  idempotencyKey     String                 @unique
  requestFingerprint String
  opportunity        SalesOpportunity       @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  actor              User                   @relation("OpportunityStageActor", fields: [actorId], references: [id], onDelete: Restrict)
  createdAt          DateTime               @default(now())

  @@index([opportunityId, createdAt])
  @@index([actorId, createdAt])
}

model SourcingQuote {
  id                   String          @id @default(uuid())
  sourcingRequestId    String
  version              Int
  productCostBdt       Decimal         @db.Decimal(12, 2)
  serviceFeeBdt        Decimal         @db.Decimal(12, 2)
  originDeliveryBdt    Decimal         @default(0) @db.Decimal(12, 2)
  estimatedShippingBdt Decimal         @db.Decimal(12, 2)
  totalBdt             Decimal         @db.Decimal(12, 2)
  fxRate               Decimal?        @db.Decimal(16, 6)
  declaredWeightGrams  Int?
  note                 String?
  status               QuoteStatus     @default(DRAFT)
  expiresAt            DateTime
  createdById          String
  reviewedById         String?
  reviewedAt           DateTime?
  reviewNote           String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  sourcingRequest      SourcingRequest @relation(fields: [sourcingRequestId], references: [id], onDelete: Restrict)
  reviewedBy           User?           @relation("SourcingQuoteReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  paymentIntent        PaymentIntent?

  @@unique([sourcingRequestId, version])
  @@index([sourcingRequestId, status])
  @@index([status, reviewedAt])
}

model Role {
