  updatedAt     DateTime      @updatedAt

  @@index([isActive, sortOrder])
}

model HelpArticle {
  id          String            @id @default(uuid())
  slug        String            @unique
  categoryId  String
  titleEn     String
  titleBn     String?
  summaryEn   String
  summaryBn   String?
  bodyEn      String
  bodyBn      String?
  keywords    String[]          @default([])
  status      HelpArticleStatus @default(DRAFT)
  isFeatured  Boolean           @default(false)
  sortOrder   Int               @default(0)
  version     Int               @default(1)
  publishedAt DateTime?
  createdById String
  updatedById String
  category    HelpCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy   User              @relation("HelpArticleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User              @relation("HelpArticleUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status, categoryId, sortOrder])
  @@index([status, isFeatured, sortOrder])
  @@index([publishedAt])
}

model AiConversation {
  id              String                  @id @default(uuid())
  tokenHash       String                  @unique
  customerId      String?
  handoffTicketId String?                 @unique
  status          AiConversationStatus    @default(ACTIVE)
  expiresAt       DateTime
  lastMessageAt   DateTime                @default(now())
  customer        User?                   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  handoffTicket   Ticket?                 @relation(fields: [handoffTicketId], references: [id], onDelete: SetNull)
  messages        AiConversationMessage[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([status, expiresAt])
  @@index([customerId, lastMessageAt])
}

model AiConversationMessage {
  id               String                    @id @default(uuid())
  conversationId   String
  turnKey          String
  role             AiConversationMessageRole
  body             String
  safetyCode       String?
  handoffSuggested Boolean                   @default(false)
  conversation     AiConversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt        DateTime                  @default(now())

  @@unique([conversationId, turnKey, role])
  @@index([conversationId, createdAt])
}

model Conversation {
  id            String                @id @default(uuid())
  ticketId      String                @unique
  status        ConversationStatus    @default(OPEN)
  lastMessageAt DateTime              @default(now())
  ticket        Ticket                @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  messages      ConversationMessage[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([status, lastMessageAt])
}

model ConversationMessage {
  id                 String       @id @default(uuid())
  idempotencyKey     String       @unique
  requestFingerprint String?
  conversationId     String
  senderId           String
  body               String
  attachmentRefs     Json?
  internalNote       Boolean      @default(false)
  readAt             DateTime?
  conversation       Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  sender             User         @relation("ConversationMessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  createdAt          DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

model TicketEvent {
  id             String        @id @default(uuid())
  ticketId       String
  fromStatus     TicketStatus?
  toStatus       TicketStatus
  actorId        String?
  note           String?
  metadata       Json?
  idempotencyKey String?       @unique
  occurredAt     DateTime      @default(now())
  ticket         Ticket        @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  actor          User?         @relation("TicketEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([ticketId, occurredAt])
  @@index([toStatus, occurredAt])
}

model PaymentIntent {
  id                    String                   @id @default(uuid())
  reference             String                   @unique
  idempotencyKey        String                   @unique
  provider              String
  paymentMethodId       String?
  sourcingQuoteId       String?                  @unique
  orderId               String?                  @unique
  fxSnapshotId          String?
  providerTransactionId String?                  @unique
  amount                Decimal                  @db.Decimal(12, 2)
  currency              String
  status                PaymentStatus            @default(CREATED)
  gatewayPayload        Json?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  sourcingQuote         SourcingQuote?           @relation(fields: [sourcingQuoteId], references: [id], onDelete: Restrict)
  order                 Order?                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  fxSnapshot            FxSnapshot?              @relation(fields: [fxSnapshotId], references: [id], onDelete: Restrict)
  paymentMethod         PaymentMethod?           @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  refunds               Refund[]
  riskDecision          PaymentRiskDecision?
  settlementEntries     PaymentSettlementEntry[]
}

model ShippingPayment {
  id              String        @id @default(uuid())
  reference       String        @unique
  idempotencyKey  String        @unique
  provider        String
  orderId         String        @unique
  shippingQuoteId String        @unique
  fxSnapshotId    String
  amount          Decimal       @db.Decimal(12, 2)
  currency        String
  status          PaymentStatus @default(CREATED)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shippingQuote   ShippingQuote @relation(fields: [shippingQuoteId], references: [id], onDelete: Restrict)
  fxSnapshot      FxSnapshot    @relation(fields: [fxSnapshotId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
}

model PaymentWebhookEvent {
  id              String    @id @default(uuid())
  provider        String
  providerEventId String
  signatureValid  Boolean
  payload         Json
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?

  @@unique([provider, providerEventId])
}

model PaymentRiskDecision {
  id                 String                  @id @default(uuid())
  paymentIntentId    String                  @unique
  decision           PaymentRiskDecisionType
  reason             String
  evidenceSnapshot   Json
  amountSnapshot     Decimal                 @db.Decimal(12, 2)
  currencySnapshot   String
  reviewedById       String
  idempotencyKey     String                  @unique
  requestFingerprint String
  reviewedAt         DateTime                @default(now())
  paymentIntent      PaymentIntent           @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  reviewedBy         User                    @relation("PaymentRiskReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([decision, reviewedAt])
  @@index([reviewedById, reviewedAt])
}

model PaymentSettlementBatch {
  id                     String                       @id @default(uuid())
  reference              String                       @unique
  provider               String
  externalBatchReference String
  settlementDate         DateTime
  currency               String
  status                 PaymentSettlementBatchStatus
  sourceFingerprint      String                       @unique
  idempotencyKey         String                       @unique
  importedById           String
  rowCount               Int
  matchedCount           Int
  exceptionCount         Int
  importedAt             DateTime                     @default(now())
  importedBy             User                         @relation("PaymentSettlementImporter", fields: [importedById], references: [id], onDelete: Restrict)
  entries                PaymentSettlementEntry[]

  @@unique([provider, externalBatchReference])
  @@index([status, settlementDate])
  @@index([importedById, importedAt])
}

model PaymentSettlementEntry {
  id                    String                                @id @default(uuid())
  batchId               String
  rowNumber             Int
  externalTransactionId String
  bankTransactionId     String?
  grossAmount           Decimal                               @db.Decimal(12, 2)
  gatewayFee            Decimal                               @default(0) @db.Decimal(12, 2)
  netAmount             Decimal                               @db.Decimal(12, 2)
  currency              String
  settledAt             DateTime
  matchStatus           PaymentSettlementMatchStatus
  exceptionReason       String?
  paymentIntentId       String?
  evidenceFingerprint   String
  createdAt             DateTime                              @default(now())
  batch                 PaymentSettlementBatch                @relation(fields: [batchId], references: [id], onDelete: Restrict)
  paymentIntent         PaymentIntent?                        @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  resolutionProposals   PaymentSettlementResolutionProposal[]
  resolutionDecisions   PaymentSettlementResolutionDecision[]

  @@unique([batchId, rowNumber])
  @@index([matchStatus, createdAt])
  @@index([externalTransactionId])
  @@index([paymentIntentId])
}

model PaymentSettlementResolutionProposal {
  id                        String                               @id @default(uuid())
  settlementEntryId         String
  resolutionType            PaymentSettlementResolutionType
  reason                    String
  evidenceReference         String
  correctedPaymentReference String?
  proposedById              String
  idempotencyKey            String                               @unique
  requestFingerprint        String
  proposedAt                DateTime                             @default(now())
  settlementEntry           PaymentSettlementEntry               @relation(fields: [settlementEntryId], references: [id], onDelete: Restrict)
  proposedBy                User                                 @relation("PaymentSettlementProposer", fields: [proposedById], references: [id], onDelete: Restrict)
  decision                  PaymentSettlementResolutionDecision?

  @@index([settlementEntryId, proposedAt], map: "PaymentSettlementResolutionProposal_settlementEntryId_proposedA")
  @@index([proposedById, proposedAt])
}

model PaymentSettlementResolutionDecision {
  id                 String                                  @id @default(uuid())
  proposalId         String                                  @unique
  settlementEntryId  String
  decision           PaymentSettlementResolutionDecisionType
  reason             String
  reviewedById       String
  idempotencyKey     String                                  @unique
  requestFingerprint String
  reviewedAt         DateTime                                @default(now())
  proposal           PaymentSettlementResolutionProposal     @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  settlementEntry    PaymentSettlementEntry                  @relation(fields: [settlementEntryId], references: [id], onDelete: Restrict)
  reviewedBy         User                                    @relation("PaymentSettlementDecisionReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([settlementEntryId, decision, reviewedAt], map: "PaymentSettlementResolutionDecision_settlementEntryId_decision_")
  @@index([reviewedById, reviewedAt])
}

model LaunchReadinessItem {
  id                String                  @id @default(uuid())
  key               String                  @unique
  category          LaunchReadinessCategory
  title             String
  requirement       String
  status            LaunchReadinessStatus   @default(NOT_STARTED)
  isRequired        Boolean                 @default(true)
  isBaseline        Boolean                 @default(false)
  ownerName         String?
  dueAt             DateTime?
  evidenceReference String?
  evidenceNote      String?
  blockerReason     String?
  version           Int                     @default(1)
  createdById       String?
  updatedById       String?
  verifiedById      String?
  verifiedAt        DateTime?
  createdBy         User?                   @relation("LaunchReadinessCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy         User?                   @relation("LaunchReadinessUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  verifiedBy        User?                   @relation("LaunchReadinessVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  events            LaunchReadinessEvent[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([status, category])
  @@index([isRequired, status])
  @@index([dueAt])
}

model LaunchReadinessEvent {
  id                        String                 @id @default(uuid())
  itemId                    String
  actorId                   String?
  fromStatus                LaunchReadinessStatus?
  toStatus                  LaunchReadinessStatus
  itemVersion               Int
  ownerNameSnapshot         String?
  dueAtSnapshot             DateTime?
  evidenceReferenceSnapshot String?
  evidenceNoteSnapshot      String?
  blockerReasonSnapshot     String?
  item                      LaunchReadinessItem    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  actor                     User?                  @relation("LaunchReadinessEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  occurredAt                DateTime               @default(now())

  @@unique([itemId, itemVersion])
  @@index([itemId, occurredAt])
  @@index([toStatus, occurredAt])
}


model PrivatePhotoUpload {
  id                  String   @id @default(uuid())
  actorId             String
  purpose             String   @db.VarChar(16)
  idempotencyKey      String   @db.VarChar(128)
  fingerprint         String   @db.VarChar(64)
  storageNamespace    String   @db.VarChar(64)
  status              String   @default("PREPARED") @db.VarChar(24)
  preparedReference   Json
  submissionScope     Json?
  originalScanSha256  String?  @db.VarChar(64)
  originalScanVerifiedAt DateTime?
  scanVerifiedSha256  String?  @db.VarChar(64)
  scanVerifiedAt      DateTime?
  encryptedBody       Bytes?
  storedReference     Json?
  attempts            Int      @default(0)
  leaseToken          String?  @db.VarChar(36)
  leaseExpiresAt      DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  actor               User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  privatePhotoLink    PrivatePhotoLink?
  quarantine          PrivatePhotoQuarantine?
  rescans             PrivatePhotoRescan[]

  @@unique([actorId, idempotencyKey])
  @@index([status, leaseExpiresAt])
  @@index([actorId, createdAt])
  privateMediaHolds PrivateMediaHold[]

}


model PrivatePhotoLink {
  id                     String @id @default(uuid())
  uploadId               String @unique
  identityVerificationId String? @unique
  inspectionEvidenceId   String? @unique
  linkedById             String
  createdAt              DateTime @default(now())
  upload                 PrivatePhotoUpload @relation(fields: [uploadId], references: [id], onDelete: Restrict)
  identityVerification   IdentityVerification? @relation(fields: [identityVerificationId], references: [id], onDelete: Restrict)
  inspectionEvidence     InspectionEvidence? @relation(fields: [inspectionEvidenceId], references: [id], onDelete: Restrict)
  linkedBy               User @relation(fields: [linkedById], references: [id], onDelete: Restrict)
  @@index([linkedById, createdAt])
}


model PrivatePhotoQuarantine {
  id             String @id @default(uuid())
  uploadId       String @unique
  actorId        String
  idempotencyKey String @db.VarChar(36)
  reason         String @db.VarChar(32)
  createdAt      DateTime @default(now())
  upload         PrivatePhotoUpload @relation(fields: [uploadId], references: [id], onDelete: Restrict)
  actor          User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  reviews        PrivatePhotoQuarantineReview[]
  rescans        PrivatePhotoRescan[]
  @@unique([actorId, idempotencyKey])
  @@index([createdAt, id])
}


model PrivatePhotoQuarantineReview {
  id             String @id @default(uuid())
  quarantineId   String
  actorId        String
  idempotencyKey String @db.VarChar(36)
  sequence       Int
  decision       String @db.VarChar(32)
  caseReference  String @db.VarChar(80)
  createdAt      DateTime @default(now())
  quarantine     PrivatePhotoQuarantine @relation(fields: [quarantineId], references: [id], onDelete: Restrict)
  actor          User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@unique([actorId, idempotencyKey])
  rescan         PrivatePhotoRescan?
  @@unique([quarantineId, sequence])
}


model PrivatePhotoRescan {
  id                String @id @default(uuid())
  uploadId          String
  quarantineId      String
  reviewId          String @unique
  actorId           String
  idempotencyKey    String @db.VarChar(36)
  storageNamespace  String @db.VarChar(64)
  referenceSnapshot Json
  createdAt         DateTime @default(now())
  deadlineAt        DateTime
  upload            PrivatePhotoUpload @relation(fields: [uploadId], references: [id], onDelete: Restrict)
  quarantine        PrivatePhotoQuarantine @relation(fields: [quarantineId], references: [id], onDelete: Restrict)
  review            PrivatePhotoQuarantineReview @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  actor             User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  result            PrivatePhotoRescanResult?
  @@unique([actorId, idempotencyKey])
  @@index([uploadId, createdAt])
}

model PrivatePhotoRescanResult {
  id          String @id @default(uuid())
  rescanId    String @unique
  state       String @db.VarChar(16)
  sha256      String? @db.VarChar(64)
  verifiedAt  DateTime?
  completedAt DateTime @default(now())
  rescan      PrivatePhotoRescan @relation(fields: [rescanId], references: [id], onDelete: Restrict)
}


model PrivateMediaPolicy {
  id String @id @default(uuid())
  sequence Int @unique
  identityDays Int
  inspectionDays Int
  abandonedHours Int
  caseReference String @db.VarChar(80)
  actorId String
  idempotencyKey String @db.VarChar(36)
  createdAt DateTime @default(now())
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@unique([actorId, idempotencyKey])
}

model PrivateMediaHold {
  id String @id @default(uuid())
  uploadId String?
  accountId String?
  orderId String?
  packageId String?
  actorId String
  caseReference String @db.VarChar(80)
  idempotencyKey String @db.VarChar(36)
  createdAt DateTime @default(now())
  upload PrivatePhotoUpload? @relation(fields: [uploadId], references: [id], onDelete: Restrict)
  account User? @relation("MediaHoldAccount", fields: [accountId], references: [id], onDelete: Restrict)
  order Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  package Package? @relation(fields: [packageId], references: [id], onDelete: Restrict)
  actor User @relation("MediaHoldActor", fields: [actorId], references: [id], onDelete: Restrict)
  release PrivateMediaHoldRelease?
  @@unique([actorId, idempotencyKey])
  @@index([uploadId])
  @@index([accountId])
  @@index([orderId])
  @@index([packageId])
  @@index([createdAt, id])
}

model PrivateMediaHoldRelease {
  id String @id @default(uuid())
  holdId String @unique
  actorId String
  caseReference String @db.VarChar(80)
  idempotencyKey String @db.VarChar(36)
  createdAt DateTime @default(now())
  hold PrivateMediaHold @relation(fields: [holdId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@unique([actorId, idempotencyKey])
}
