  marketRate         Decimal             @db.Decimal(18, 8)
  spreadPercent      Decimal             @default(0) @db.Decimal(10, 6)
  source             ExchangeRateSource
  sourceReference    String?
  status             ExchangeRateStatus  @default(DRAFT)
  financeApproved    Boolean             @default(false)
  complianceApproved Boolean             @default(false)
  validFrom          DateTime
  validTo            DateTime?
  activatedAt        DateTime?
  revokedAt          DateTime?
  createdById        String
  snapshots          FxSnapshot[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([baseCurrency, quoteCurrency, customerSegment, status, validFrom, validTo])
  @@index([status, validFrom, validTo])
}

model ShippingLane {
  id                                String             @id @default(uuid())
  originCountryId                   String
  destinationCountryId              String
  name                              String
  dimensionalWeightDivisor          Int
  weightDiscrepancyThresholdPercent Decimal            @default(10.00) @db.Decimal(6, 2)
  // Customer-facing planning figures only. A ShippingQuote remains the sole
  // payable amount and is created after the warehouse measures the parcel.
  estimatedRatePerKgBdt             Decimal?           @db.Decimal(12, 2)
  estimatedLastMileRatePerKgBdt     Decimal?           @db.Decimal(12, 2)
  estimatedHandlingFeeBdt           Decimal?           @db.Decimal(12, 2)
  estimatedMinimumChargeBdt         Decimal?           @db.Decimal(12, 2)
  transitDaysMin                    Int?
  transitDaysMax                    Int?
  isActive                          Boolean            @default(false)
  financeApproved                   Boolean            @default(false)
  complianceApproved                Boolean            @default(false)
  operationsApproved                Boolean            @default(false)
  checkoutEnabled                   Boolean            @default(false)
  originCountry                     Country            @relation("LaneOrigin", fields: [originCountryId], references: [id], onDelete: Restrict)
  destinationCountry                Country            @relation("LaneDestination", fields: [destinationCountryId], references: [id], onDelete: Restrict)
  shippingQuotes                    ShippingQuote[]
  orders                            Order[]
  shipForMeRequests                 ShipForMeRequest[]
  createdAt                         DateTime           @default(now())
  updatedAt                         DateTime           @updatedAt

  @@unique([originCountryId, destinationCountryId, name])
  @@index([originCountryId, destinationCountryId, isActive, checkoutEnabled])
}

model ShippingQuote {
