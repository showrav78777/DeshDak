  updatedAt   DateTime   @updatedAt
}

model UserRole {
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@id([userId, roleId])
}

model SellerProfile {
  id                   String                    @id @default(uuid())
  storeCode            String                    @unique @default(dbgenerated())
  userId               String                    @unique
  businessName         String
  storeSlug            String?                   @unique
  storeDescription     String?
  tradeLicenseNo       String?
  nidOrTin             String?
  businessAddress      String?
  originCountryCode    String                    @default("BD")
  shipsInternationally Boolean                   @default(true)
  processingDays       Int                       @default(3)
  version              Int                       @default(1)
  status               SellerStatus              @default(DRAFT)
  reviewNote           String?
  reviewedAt           DateTime?
  user                 User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  products             Product[]
  productRevisions     ProductRevision[]
  storeRevisions       SellerStoreRevision[]
  sellerOrders         SellerOrder[]
  catalogImports       SellerCatalogImport[]
  catalogConnections   SellerCatalogConnection[]
  reels                Reel[]
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@index([status, originCountryCode])
}

model SellerCatalogConnection {
  id                            String                        @id @default(uuid())
  sellerProfileId               String
  systemName                    String
  systemKey                     String
  apiBaseUrl                    String
  apiDocumentationUrl           String?
  authMethod                    SellerCatalogAuthMethod
  requestedCapabilities         String[]                      @default([])
  expectedProductCount          Int?
  requestedSyncFrequencyMinutes Int?
  sellerNote                    String?
  consentVersion                String
  consentGrantedAt              DateTime
  consentRevokedAt              DateTime?
  status                        SellerCatalogConnectionStatus @default(PENDING_REVIEW)
  adapterKey                    String?
  secretReference               String?
  dataUseApproved               Boolean                       @default(false)
  mediaRightsApproved           Boolean                       @default(false)
  securityApproved              Boolean                       @default(false)
  reviewNote                    String?
  reviewedById                  String?
  reviewedAt                    DateTime?
  version                       Int                           @default(1)
  sellerProfile                 SellerProfile                 @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  reviewedBy                    User?                         @relation("SellerCatalogConnectionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt                     DateTime                      @default(now())
  updatedAt                     DateTime                      @updatedAt

  @@unique([sellerProfileId, systemKey])
  @@index([status, createdAt])
  @@index([sellerProfileId, status, createdAt])
}

model SellerCatalogImport {
  id               String                    @id @default(uuid())
  sellerProfileId  String
  status           SellerCatalogImportStatus @default(PREVIEW_READY)
  originalFilename String?
  fingerprint      String
  mapping          Json
  totalRows        Int
  validRows        Int
  invalidRows      Int
  version          Int                       @default(1)
  expiresAt        DateTime
  confirmedAt      DateTime?
  sellerProfile    SellerProfile             @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  rows             SellerCatalogImportRow[]
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@index([sellerProfileId, status, createdAt])
  @@index([sellerProfileId, fingerprint])
}

model SellerCatalogImportRow {
  id               String                       @id @default(uuid())
  catalogImportId  String
  rowNumber        Int
  status           SellerCatalogImportRowStatus
  sourceData       Json
  normalizedData   Json?
  validationErrors Json
  fingerprint      String
  productId        String?                      @unique
  catalogImport    SellerCatalogImport          @relation(fields: [catalogImportId], references: [id], onDelete: Cascade)
  product          Product?                     @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  @@unique([catalogImportId, rowNumber])
  @@index([catalogImportId, status, rowNumber])
}

model SellerStoreRevision {
  id                String                    @id @default(uuid())
  sellerProfileId   String
  status            SellerStoreRevisionStatus @default(PENDING_REVIEW)
  baseSellerVersion Int
  businessName      String
  storeDescription  String
  processingDays    Int
  submittedAt       DateTime                  @default(now())
  reviewedAt        DateTime?
  reviewerId        String?
  reviewNote        String?
  version           Int                       @default(1)
  sellerProfile     SellerProfile             @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  reviewer          User?                     @relation("SellerStoreRevisionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([sellerProfileId, status, submittedAt])
}

model Country {
  id               String                 @id @default(uuid())
  isoCode          String                 @unique
  name             String
  defaultCurrency  String
  defaultLocale    String                 @default("en")
  isActive         Boolean                @default(false)
  originLanes      ShippingLane[]         @relation("LaneOrigin")
  destinationLanes ShippingLane[]         @relation("LaneDestination")
  paymentMethods   CountryPaymentMethod[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
}

model PaymentMethod {
  id                  String                 @id @default(uuid())
  code                String                 @unique
  displayName         String
  kind                PaymentMethodKind
  adapterCode         String
  settlementCurrency  String
  secretReference     String?
  isActive            Boolean                @default(false)
  countryAvailability CountryPaymentMethod[]
  paymentIntents      PaymentIntent[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([isActive, code])
}

model CountryPaymentMethod {
  id                     String        @id @default(uuid())
  countryId              String
  paymentMethodId        String
  customerCurrency       String
  minimumAmount          Decimal?      @db.Decimal(12, 2)
  maximumAmount          Decimal?      @db.Decimal(12, 2)
