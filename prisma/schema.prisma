model User {
  id                          String                                @id @default(uuid())
  personCode                  String                                @unique @default(dbgenerated())
  email                       String                                @unique
  phone                       String?                               @unique
  phoneVerifiedAt             DateTime?
  residenceCountryCode        String                                @default("BD") @db.VarChar(2)
  passwordHash                String
  fullName                    String
  status                      UserStatus                            @default(PENDING_VERIFICATION)
  locale                      String                                @default("bn")
  accountType                 CustomerAccountType                   @default(PERSONAL)
  googleSubject               String?                               @unique
  googleLinkedAt              DateTime?
  preferredCurrency           String                                @default("BDT")
  kycStatus                   KycStatus                             @default(NOT_REQUIRED)
  analyticsConsent            Boolean                               @default(false)
  analyticsConsentAt          DateTime?
  roles                       UserRole[]
  sellerProfile               SellerProfile?
  auditLogs                   AuditLog[]                            @relation("AuditActor")
  paymentRiskDecisions        PaymentRiskDecision[]                 @relation("PaymentRiskReviewer")
  paymentSettlementImports    PaymentSettlementBatch[]              @relation("PaymentSettlementImporter")
  paymentSettlementProposals  PaymentSettlementResolutionProposal[] @relation("PaymentSettlementProposer")
  paymentSettlementDecisions  PaymentSettlementResolutionDecision[] @relation("PaymentSettlementDecisionReviewer")
  refundGatewayOperations     RefundGatewayOperation[]              @relation("RefundGatewayOperationActor")
  sourcingRequests            SourcingRequest[]
  shipForMeRequests           ShipForMeRequest[]
  orders                      Order[]
  supplierOrderRecords        SupplierOrderRecord[]
  supplierRecordCorrections   SupplierRecordCorrection[]
  supplierInboundDispatches   SupplierInboundDispatch[]
  addresses                   Address[]
  authSessions                AuthSession[]
  mfaMethod                   MfaMethod?
  mfaEnrollment               MfaEnrollment?
  userEvents                  UserEvent[]
  notifications               Notification[]
  notificationPreferences     NotificationPreference[]
  marketingCampaignsCreated   MarketingCampaign[]                   @relation("MarketingCampaignCreator")
  advertisementsCreated       Advertisement[]                       @relation("AdvertisementCreator")
  marketingCampaignRecipients MarketingCampaignRecipient[]          @relation("MarketingCampaignRecipientUser")
  securityTokens              SecurityToken[]
  privatePhotoUploads         PrivatePhotoUpload[]
  privatePhotoLinks           PrivatePhotoLink[]
  privatePhotoQuarantines     PrivatePhotoQuarantine[]
  privatePhotoQuarantineReviews PrivatePhotoQuarantineReview[]
  privatePhotoRescans          PrivatePhotoRescan[]
  privateMediaPolicies        PrivateMediaPolicy[]
  privateMediaHoldsCreated    PrivateMediaHold[] @relation("MediaHoldActor")
  privateMediaAccountHolds    PrivateMediaHold[] @relation("MediaHoldAccount")
  privateMediaHoldReleases    PrivateMediaHoldRelease[]
  identityVerifications       IdentityVerification[]                @relation("IdentityVerificationCustomer")
  identityVerificationsReviewed IdentityVerification[]              @relation("IdentityVerificationReviewer")
  maintenanceRuns             MaintenanceJobRun[]                   @relation("MaintenanceRunActor")
  maintenanceConfigs          MaintenanceConfiguration[]            @relation("MaintenanceConfigActor")
  launchReadinessCreated      LaunchReadinessItem[]                 @relation("LaunchReadinessCreator")
  launchReadinessUpdated      LaunchReadinessItem[]                 @relation("LaunchReadinessUpdater")
  launchReadinessVerified     LaunchReadinessItem[]                 @relation("LaunchReadinessVerifier")
  launchReadinessEvents       LaunchReadinessEvent[]                @relation("LaunchReadinessEventActor")
  carts                       Cart[]
  wallets                     Wallet[]
  warehouseAssignments        WarehouseStaffAssignment[]            @relation("WarehouseStaff")
  warehouseAssignmentsMade    WarehouseStaffAssignment[]            @relation("WarehouseStaffAssigner")
  packageEvents               PackageEvent[]                        @relation("PackageEventActor")
  inspectionsPerformed        Inspection[]                          @relation("InspectionInspector")
  inspectionEvidenceUploaded  InspectionEvidence[]                  @relation("InspectionEvidenceUploader")
  shipmentEvents              ShipmentEvent[]                       @relation("ShipmentEventActor")
  rmas                        Rma[]                                 @relation("RmaCustomer")
  rmaDeadlineOverrides        Rma[]                                 @relation("RmaDeadlineOverrider")
  rmaInspections              Rma[]                                 @relation("RmaInspector")
  rmaRefundDecisions          Rma[]                                 @relation("RmaRefundDecisionMaker")
  sourcingQuotesReviewed      SourcingQuote[]                       @relation("SourcingQuoteReviewer")
  rmaEvents                   RmaEvent[]                            @relation("RmaEventActor")
  rmaMessages                 RmaMessage[]                          @relation("RmaMessageSender")
  supportTickets              Ticket[]                              @relation("TicketCustomer")
  assignedSupportTickets      Ticket[]                              @relation("TicketAssignedAgent")
  supportAgentProfile         SupportAgentProfile?                  @relation("SupportAgentProfileUser")
  supportProfilesUpdated      SupportAgentProfile[]                 @relation("SupportAgentProfileUpdater")
  supportReviewsReceived      SupportQualityReview[]                @relation("SupportQualityAgent")
  supportReviewsMade          SupportQualityReview[]                @relation("SupportQualityReviewer")
  supportPoliciesUpdated      SupportOperatingPolicy[]              @relation("SupportPolicyUpdater")
  supportShifts               SupportShift[]                        @relation("SupportShiftAgent")
  supportShiftsCreated        SupportShift[]                        @relation("SupportShiftCreator")
  supportRatingsSubmitted     SupportSatisfactionRating[]           @relation("SupportSatisfactionCustomer")
  supportRatingsReceived      SupportSatisfactionRating[]           @relation("SupportSatisfactionAgent")
  helpCategoriesCreated       HelpCategory[]                        @relation("HelpCategoryCreator")
  helpCategoriesUpdated       HelpCategory[]                        @relation("HelpCategoryUpdater")
  helpArticlesCreated         HelpArticle[]                         @relation("HelpArticleCreator")
  helpArticlesUpdated         HelpArticle[]                         @relation("HelpArticleUpdater")
  productRevisionsReviewed    ProductRevision[]                     @relation("ProductRevisionReviewer")
  productReviews              ProductReview[]                       @relation("ProductReviewCustomer")
  wishlistItems               WishlistItem[]
  productReviewsModerated     ProductReview[]                       @relation("ProductReviewModerator")
  productReviewDecisions      ProductReviewModeration[]             @relation("ProductReviewDecisionModerator")
  storeRevisionsReviewed      SellerStoreRevision[]                 @relation("SellerStoreRevisionReviewer")
  catalogConnectionsReviewed  SellerCatalogConnection[]             @relation("SellerCatalogConnectionReviewer")
  ticketEvents                TicketEvent[]                         @relation("TicketEventActor")
  conversationMessages        ConversationMessage[]                 @relation("ConversationMessageSender")
  aiConversations             AiConversation[]
  packageExceptionsReported   PackageException[]                    @relation("PackageExceptionReporter")
  packageExceptionsResolved   PackageException[]                    @relation("PackageExceptionResolver")
  warehousePoliciesUpdated    WarehouseExceptionPolicy[]            @relation("WarehouseExceptionPolicyUpdater")
  packageServicesRequested    PackageServiceRequest[]               @relation("PackageServiceCustomer")
  packageServicesReviewed     PackageServiceRequest[]               @relation("PackageServiceReviewer")
  packageServicesCompleted    PackageServiceRequest[]               @relation("PackageServiceWorker")
  couponRedemptions           CouponRedemption[]
  promotionApplications       PromotionApplication[]
  reelsModerated              Reel[]                                @relation("ReelModerator")
  reelEngagements             ReelEngagement[]
  reelReactions               ReelReaction[]
  reelComments                ReelComment[]                         @relation("ReelCommentAuthor")
  reelCommentsModerated       ReelComment[]                         @relation("ReelCommentModerator")
  businessAccount             BusinessAccount?                      @relation("BusinessAccountOwner")
  kamAssignments              KamAssignment[]                       @relation("KamAssignee")
  kamAssignmentsMade          KamAssignment[]                       @relation("KamAssigner")
  accountActivities           AccountActivity[]                     @relation("AccountActivityAuthor")
  salesOpportunities          SalesOpportunity[]                    @relation("SalesOpportunityOwner")
  opportunityStageChanges     OpportunityStageChange[]              @relation("OpportunityStageActor")
  createdAt                   DateTime                              @default(now())
  updatedAt                   DateTime                              @updatedAt
  deletedAt                   DateTime?

  @@index([residenceCountryCode, createdAt])
}

model IdentityVerification {
  id                   String               @id @default(uuid())
  userId               String
  documentType         IdentityDocumentType
  issuingCountryCode   String               @db.VarChar(2)
  documentNumberLast4  String               @db.VarChar(4)
  documentPhotoCiphertext String?           @db.Text
  documentPhotoIv         String?           @db.VarChar(32)
  documentPhotoTag        String?           @db.VarChar(32)
  documentPhotoMimeType   String?           @db.VarChar(64)
  documentPhotoSizeBytes  Int?
  documentPhotoSha256     String?           @db.VarChar(64)
  status               KycStatus            @default(PENDING)
  submittedAt          DateTime             @default(now())
  reviewedAt           DateTime?
  reviewedById         String?
  reviewNote           String?
  version              Int                  @default(1)
  user                 User                 @relation("IdentityVerificationCustomer", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy           User?                @relation("IdentityVerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  privatePhotoLink     PrivatePhotoLink?

  @@index([userId, status, submittedAt])
  @@index([status, submittedAt])
}

model Notification {
  id                         String                      @id @default(uuid())
  userId                     String
  eventType                  String
  category                   NotificationCategory        @default(TRANSACTIONAL)
  priority                   NotificationPriority        @default(NORMAL)
  title                      String
  body                       String
  titleBn                    String?
  bodyBn                     String?
  deepLink                   String?
  entityType                 String?
  entityId                   String?
  idempotencyKey             String                      @unique
  readAt                     DateTime?
  user                       User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries                 NotificationDelivery[]
  marketingCampaignRecipient MarketingCampaignRecipient?
  createdAt                  DateTime                    @default(now())

  @@index([userId, readAt, createdAt])
  @@index([entityType, entityId])
}

model NotificationDelivery {
  id                      String                     @id @default(uuid())
  notificationId          String
  channel                 NotificationChannel
  status                  NotificationDeliveryStatus @default(QUEUED)
  idempotencyKey          String                     @unique
  attempts                Int                        @default(0)
  nextAttemptAt           DateTime?
  providerReference       String?
  recipientHash           String?
  providerEventAt         DateTime?
  providerEventType       String?
  lastError               String?
  securePayloadCiphertext String?
  securePayloadIv         String?
  securePayloadTag        String?
  sentAt                  DateTime?
  deliveredAt             DateTime?
  failedAt                DateTime?
  readAt                  DateTime?
  notification            Notification               @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  emailEvents             EmailWebhookEvent[]
  emailSuppressions       EmailSuppression[]
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  @@index([channel, status, nextAttemptAt])
  @@index([notificationId, channel])
  @@index([channel, providerReference])
}

model EmailWebhookEvent {
  id                String                @id @default(uuid())
  messageId         String                @unique
  providerReference String
  eventType         String
  payloadHash       String
  occurredAt        DateTime
  outcome           String                @default("PENDING")
  processedAt       DateTime?
  deliveryId        String?
  delivery          NotificationDelivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  createdAt         DateTime              @default(now())

  @@index([providerReference, processedAt])
  @@index([createdAt])
}

model EmailSuppression {
  id               String                @id @default(uuid())
  recipientHash    String                @unique
  reason           String
  active           Boolean               @default(true)
  version          Int                   @default(1)
  sourceDeliveryId String?
  sourceDelivery   NotificationDelivery? @relation(fields: [sourceDeliveryId], references: [id], onDelete: SetNull)
  firstSeenAt      DateTime              @default(now())
  lastSeenAt       DateTime
  releasedAt       DateTime?
  releasedById     String?
  releaseReason    String?
  evidenceReference String?

  @@index([active, lastSeenAt])
}

model SecurityToken {
  id        String               @id @default(uuid())
  userId    String
  purpose   SecurityTokenPurpose
  tokenHash String               @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime             @default(now())

  @@index([userId, purpose, usedAt, expiresAt])
  @@index([expiresAt])
}

model SecurityRateLimit {
  id              String    @id @default(uuid())
  scope           String
  keyHash         String
  attempts        Int       @default(0)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([scope, keyHash])
  @@index([blockedUntil])
  @@index([updatedAt])
}

model MaintenanceConfiguration {
  key                         String   @id
  securityTokenRetentionDays  Int      @default(30)
  rateLimitRetentionHours     Int      @default(24)
  mfaEnrollmentRetentionHours Int      @default(24)
  inventoryBatchSize          Int      @default(100)
  updatedById                 String?
  updatedBy                   User?    @relation("MaintenanceConfigActor", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

model WarehouseExceptionPolicy {
  key                      String   @id @default("GLOBAL")
  expectedParcelAlertHours Int      @default(168)
  exceptionResolutionHours Int      @default(24)
  storageWarningDays       Int      @default(30)
  updatedById              String?
  updatedBy                User?    @relation("WarehouseExceptionPolicyUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model MaintenanceJobState {
  jobKey         String                @id
  lockedUntil    DateTime?
  lastStartedAt  DateTime?
  lastFinishedAt DateTime?
  lastStatus     MaintenanceRunStatus?
  lastSummary    Json?
  lastErrorCode  String?
  updatedAt      DateTime              @updatedAt
}

model MaintenanceJobRun {
  id            String               @id @default(uuid())
  jobKey        String
  triggerSource String
  status        MaintenanceRunStatus @default(RUNNING)
  triggeredById String?
  startedAt     DateTime             @default(now())
  finishedAt    DateTime?
  summary       Json?
  errorCode     String?
  triggeredBy   User?                @relation("MaintenanceRunActor", fields: [triggeredById], references: [id], onDelete: SetNull)

  @@index([jobKey, startedAt])
  @@index([status, startedAt])
}

model NotificationTemplate {
