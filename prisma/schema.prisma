  chargeableWeightGrams       Int
  declaredWeightGrams         Int?
  discrepancyPercent          Decimal?            @db.Decimal(8, 2)
  discrepancyThresholdPercent Decimal             @db.Decimal(6, 2)
  ratePerKgBdt                Decimal             @db.Decimal(12, 2)
  shippingAmountBdt           Decimal             @db.Decimal(12, 2)
  lastMileRatePerKgBdt        Decimal             @default(0) @db.Decimal(12, 2)
  lastMileDeliveryBdt         Decimal             @default(0) @db.Decimal(12, 2)
  handlingFeeBdt              Decimal             @default(0) @db.Decimal(12, 2)
  insuranceFeeBdt             Decimal             @default(0) @db.Decimal(12, 2)
  totalBdt                    Decimal             @db.Decimal(12, 2)
