# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/playwright-report-docker/
/playwright-report-*/
/test-results/
/test-results-*/
/blob-report/
/all-blob-reports/
/e2e/.auth/

# next.js
/.next/
/.next-*/
/out/

# production
/build
/backups
/tmp/
/output/
/LINK.docx

# misc
.DS_Store
~$*
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
