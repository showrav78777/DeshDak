# Non-secret engine policy; retain this when deploying an approved image.
CLAMD_CONF_StreamMaxLength=8M
CLAMD_CONF_MaxFileSize=8M
CLAMD_CONF_MaxScanSize=64M
CLAMD_CONF_MaxRecursion=10
CLAMD_CONF_MaxFiles=1000
CLAMD_CONF_MaxScanTime=8000
CLAMD_CONF_AlertExceedsMax=yes
CLAMD_CONF_SelfCheck=30
CLAMD_CONF_ConcurrentDatabaseReload=no
CLAMD_CONF_MaxThreads=2
CLAMD_CONF_MaxQueue=4
CLAMD_CONF_ReadTimeout=10
CLAMD_CONF_CommandReadTimeout=5
FRESHCLAM_CHECKS=12
