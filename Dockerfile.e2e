FROM mcr.microsoft.com/playwright:v1.64.1-noble
WORKDIR /work
COPY package.json package-lock.json ./
COPY prisma ./prisma
RUN npm install --global npm@11.6.2 && npm ci && chown -R pwuser:pwuser /work
COPY --chown=pwuser:pwuser . .
USER pwuser
ENV CI=true
# Run only against an approved local test app on the container network.
CMD ["npm", "run", "test:e2e"]
