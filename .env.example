# Local PostgreSQL database. Never commit a real .env file or provider credentials.
DATABASE_URL="postgresql://crossly:crossly_dev_password@localhost:5432/crossly?schema=public"

# Generate a long random value before enabling authentication in any environment.
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_ISSUER="http://localhost:3000"
APP_BASE_URL="http://localhost:3000"

# Test-only HTTP origin used by verification scripts when it differs from APP_BASE_URL.
TEST_BASE_URL="http://localhost:3000"

# Explicit non-production demo-data gate. Never enable this in production.
DEMO_DATA_ENABLED="false"
# Optional shared password for fictional *@example.test accounts created by seed:demo.
DEMO_ACCOUNT_PASSWORD=""

# Independent base64-encoded 32-byte key for encrypted security-email payloads.
# Generate for production with: openssl rand -base64 32
AUTH_OUTBOX_ENCRYPTION_KEY=""

# Transactional email. Verify the sending domain, set a server-only Resend key,
# then enable and test the notification delivery scheduler before live use.
EMAIL_DELIVERY_ENABLED="false"
RESEND_API_KEY=""
EMAIL_FROM=""

# Local demo only: returns the new account's verification link directly after
# registration. It is ignored in production; use a verified email provider there.
ALLOW_DEV_AUTH_LINKS="false"

# Development only: permits encrypted document-photo intake in the local database.
# Never enable in production. Production must use a private storage, malware scanning,
# metadata processing, retention, and access-logging integration approved by Compliance.
ALLOW_DEV_KYC_DOCUMENT_UPLOADS="false"
# Independent base64-encoded 32-byte key for encrypting local/staging KYC document photos.
# Required for any production adapter; do not reuse AUTH_SECRET.
KYC_DOCUMENT_ENCRYPTION_KEY=""

# Independent base64-encoded 32-byte key for MFA secrets and recovery-code hashing.
MFA_ENCRYPTION_KEY=""

# Separate scheduler credential for protected maintenance endpoints (minimum 32 characters).
MAINTENANCE_JOB_SECRET=""

# The ingress must remove caller-supplied copies, set the chosen client-IP header,
# and inject the separate proxy proof header before traffic reaches Next.js.
TRUSTED_CLIENT_IP_HEADER=""
TRUSTED_PROXY_SHARED_SECRET=""

# Required only before first admin setup in production. Set a long random value in hosting settings;
# enter it once at /admin/setup, then remove or rotate it after setup.
INITIAL_ADMIN_SETUP_TOKEN=""

# Human verification. Production fails closed if TURNSTILE_SECRET_KEY is missing.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
TURNSTILE_EXPECTED_HOSTNAME=""

# Social login and phone OTP provider credentials — server-side only except public client IDs.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional. Defaults to APP_BASE_URL/api/v1/auth/oauth/google/callback; must match the
# callback URL registered with Google exactly. Never expose GOOGLE_CLIENT_SECRET.
GOOGLE_OAUTH_REDIRECT_URI=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
SMS_PROVIDER_API_KEY=""
SMS_PROVIDER_SENDER_ID=""

# Payment gateway credentials — keep only in a secret manager outside source control.
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
NAGAD_MERCHANT_ID=""
NAGAD_MERCHANT_PRIVATE_KEY=""
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
# Explicitly choose sandbox during certification; use live only after signed launch approval.
SSLCOMMERZ_ENVIRONMENT="sandbox"

# Keep empty until an implemented gateway adapter, signed webhooks, refunds, and
# reconciliation have passed sandbox/UAT certification. Comma-separated when enabled.
PAYMENT_ADAPTERS_ENABLED=""

# Optional public origin for approved, processed product/Reel media. Production requires HTTPS.
# Configure only after signed uploads, malware scanning, transcoding and CDN controls are operational.
PUBLIC_MEDIA_BASE_URL=""
WEBSITE_MEDIA_SCAN_URL=""
WEBSITE_MEDIA_SCAN_TOKEN=""

# Local-only encrypted warehouse photo/video capture. Production always disables
# this adapter until private object storage and malware scanning are integrated.
ALLOW_DEV_INSPECTION_EVIDENCE_UPLOADS="false"
INSPECTION_EVIDENCE_ENCRYPTION_KEY=""

# Provider keys stay server-side and will be stored in a secret manager for production.
PINDUODUO_API_KEY=""
ALIBABA_API_KEY=""
SOURCE_1688_API_KEY=""

# Optional real conversational model for the public shopping assistant. Keep this
# server-side only; never expose it through NEXT_PUBLIC_* variables or source control.
# Without these values the assistant safely uses its catalog-and-rules fallback.
OPENAI_API_KEY=""
OPENAI_CHAT_MODEL="gpt-5.5"
